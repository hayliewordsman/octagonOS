__pycache__/
*.pyc

# Built APKs. The sources and the build scripts are the deliverable; the
# binaries need a signing key that does not belong in git.
mobile/overlay/out/
mobile/iconpack/out/

# The boot animation IS committed -- see mobile/bootanimation/out/. It is built
# here, reproducibly, from committed sources, and an image needs it at inject
# time whether or not the builder has Pillow.

# Screenshots from the Plymouth harness. They are evidence for one run, not an
# artifact: the theme itself is committed, and the harness regenerates these.
desktop/tools/*.png
desktop/tools/*.xwd

# The Plymouth theme IS committed, like the boot animation: it is generated
# reproducibly from committed sources, and CI rebuilds it and diffs.

# Out-of-tree build trees for the KWin effect. The sources and the CMakeLists
# are the deliverable; the .so must be built against the KWin it will run on,
# so a committed binary would be wrong by the next KWin release.
desktop/kwin/*/build/
