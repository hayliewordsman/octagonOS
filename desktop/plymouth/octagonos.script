# octagonOS Plymouth theme.
#
# The octagonOS mark, rendered from FacetUI's shader maths, plus everything
# Plymouth can be asked to put on screen during a boot.
#
# THE PASSPHRASE PROMPT IS THE IMPORTANT PART OF THIS FILE
#
# A boot theme that only draws an animation looks finished and is not. On a
# machine with an encrypted disk, Plymouth asks the theme to display a
# passphrase prompt, and if the theme does not implement that callback nothing
# is drawn: the user sees an animation, types blind, and has no way to know the
# machine is waiting for them. It is the single most common way a custom boot
# theme ruins a machine, and it is invisible until someone with LUKS boots it.
#
# So this file implements, deliberately and in this order:
#
#   display_password   the prompt, and a bullet per character typed
#   display_question   the same, for non-secret answers, shown in the clear
#   display_message    messages Plymouth wants shown (fsck progress, warnings)
#   display_normal     TEARS ALL OF THAT DOWN AGAIN
#   quit               resolves the animation
#
# display_normal is the one that is easy to forget and leaves a stale prompt on
# screen after the disk unlocks.

# intro_count, loop_count, outro_count, frame_size and fps are PREPENDED to
# this file by make-plymouth-theme.py. They are not defined here, and this file
# is not what gets installed -- the generated concatenation is.
#
# They are prepended rather than kept in a second file because PLYMOUTH LOADS
# EXACTLY ONE SCRIPT: the ScriptFile named in the .plymouth config. Another
# .script sitting in the theme directory is never read.

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# The same flat colour the mark fades to at its edges, so the frames do not sit
# in a visible square. BG_BASE in shared/facetui/palette.py, as 0..1.
Window.SetBackgroundTopColor(0.016, 0.021, 0.031);
Window.SetBackgroundBottomColor(0.016, 0.021, 0.031);

# --- frames -----------------------------------------------------------------

i = 0;
while (i < intro_count) {
    intro[i] = Image("intro-" + i + ".png");
    i = i + 1;
}
i = 0;
while (i < loop_count) {
    loop[i] = Image("loop-" + i + ".png");
    i = i + 1;
}
i = 0;
while (i < outro_count) {
    outro[i] = Image("outro-" + i + ".png");
    i = i + 1;
}

mark = Sprite();
mark.SetX((screen_width - frame_size) / 2);
# Above centre, so the passphrase prompt below it is not crowded.
mark_y = (screen_height - frame_size) / 2 - screen_height / 12;
mark.SetY(mark_y);
mark.SetZ(1);
mark.SetImage(intro[0]);

# --- animation state --------------------------------------------------------

phase = "intro";          # intro -> loop -> outro
frame = 0;
tick = 0;
# Plymouth refreshes at roughly 50Hz; advance a frame every other tick for 24fps.
ticks_per_frame = 2;

# Dimmed while the user is being asked for something, so attention goes to the
# prompt rather than to a spinning octagon.
mark_opacity = 1.0;
target_opacity = 1.0;

# How long an on-screen message has left. Declared here, with the rest of the
# state refresh() touches, rather than beside display_message further down: a
# name has to exist globally before a function assigns to it, or the assignment
# makes a local and the global never changes.
message_ticks = 0;
message_lifetime = 8 * 50;     # ~8s, at Plymouth's ~50Hz refresh

fun refresh() {
    # Ease toward the target rather than snapping, so the dim does not look
    # like a glitch when the prompt appears.
    if (mark_opacity < target_opacity) {
        mark_opacity = mark_opacity + 0.06;
        if (mark_opacity > target_opacity) { mark_opacity = target_opacity; }
    }
    if (mark_opacity > target_opacity) {
        mark_opacity = mark_opacity - 0.06;
        if (mark_opacity < target_opacity) { mark_opacity = target_opacity; }
    }
    mark.SetOpacity(mark_opacity);

    # Age any on-screen message. See the note by display_message: hiding one
    # from outside the theme does not reliably reach us.
    if (message_ticks > 0) {
        message_ticks = message_ticks - 1;
        if (message_ticks == 0) { message_sprite.SetOpacity(0); }
    }

    tick = tick + 1;
    if (tick < ticks_per_frame) { return; }
    tick = 0;

    if (phase == "intro") {
        mark.SetImage(intro[frame]);
        frame = frame + 1;
        if (frame >= intro_count) { phase = "loop"; frame = 0; }
    } else if (phase == "loop") {
        mark.SetImage(loop[frame]);
        frame = frame + 1;
        if (frame >= loop_count) { frame = 0; }
    } else {
        # outro: hold on the last frame rather than looping back
        if (frame < outro_count) {
            mark.SetImage(outro[frame]);
            frame = frame + 1;
        }
    }
}

Plymouth.SetRefreshFunction(refresh);

# --- prompts ----------------------------------------------------------------
#
# EVERY SPRITE AND IMAGE USED FROM A CALLBACK IS CREATED HERE, AT LOAD.
#
# Plymouth script scopes assignment by function: writing to a name that already
# exists globally updates the global, but writing to one that does not creates
# a function-local that is destroyed when the function returns. So
#
#     fun display_password(prompt, count) { bullets[0] = Sprite(); ... }
#
# builds a sprite, draws nothing, and discards it -- with no error. That cost a
# debugging session: the prompt appeared and the bullets never did, which reads
# as a positioning bug rather than a scoping one.
#
# Pre-allocating is also the right thing on a boot path: no allocation happens
# while the user is typing.

max_bullets = 32;

prompt_sprite = Sprite();
prompt_sprite.SetZ(10);
prompt_sprite.SetOpacity(0);

bullet_image = Image("bullet.png");
prompt_fallback = Image("prompt-fallback.png");

# The image a prompt is rendered into. Global for the same reason: a sprite
# outlives the call that set its image, so the image must too.
prompt_image = 0;
message_image = 0;

prompt_y = mark_y + frame_size + screen_height / 24;
bullet_y = prompt_y + 46;

i = 0;
while (i < max_bullets) {
    bullets[i] = Sprite();
    bullets[i].SetImage(bullet_image);
    bullets[i].SetZ(10);
    bullets[i].SetOpacity(0);
    i = i + 1;
}

bullet_spacing = bullet_image.GetWidth() + 8;

fun clear_bullets() {
    i = 0;
    while (i < max_bullets) {
        bullets[i].SetOpacity(0);
        i = i + 1;
    }
}

fun show_prompt_text(text) {
    # Image.Text needs a label plugin (label.so) and a font present in the
    # initramfs. When either is missing it yields nothing, and the user is left
    # looking at an animation with no indication the machine wants a
    # passphrase. This is not hypothetical: the machine this theme was
    # developed on has no label plugin, so the fallback is the path that
    # actually ran.
    #
    # Measure what came back and fall back to a pre-rendered image rather than
    # showing nothing.
    prompt_image = Image.Text(text, 0.886, 0.925, 0.980, 1.0, "Sans 15");
    if (!prompt_image || prompt_image.GetWidth() < 1) {
        prompt_image = prompt_fallback;
    }
    prompt_sprite.SetImage(prompt_image);
    prompt_sprite.SetX((screen_width - prompt_image.GetWidth()) / 2);
    prompt_sprite.SetY(prompt_y);
    prompt_sprite.SetOpacity(1);
}

fun show_bullets(count) {
    clear_bullets();
    if (count < 1) { return; }
    # Cap the row rather than letting a long passphrase run off both edges.
    shown = count;
    if (shown > max_bullets) { shown = max_bullets; }

    total = shown * bullet_spacing - 8;
    start = (screen_width - total) / 2;

    i = 0;
    while (i < shown) {
        bullets[i].SetX(start + i * bullet_spacing);
        bullets[i].SetY(bullet_y);
        bullets[i].SetOpacity(1);
        i = i + 1;
    }
}

fun display_password(prompt, bullet_count) {
    target_opacity = 0.45;
    if (prompt) {
        show_prompt_text(prompt);
    } else {
        prompt_sprite.SetImage(prompt_fallback);
        prompt_sprite.SetX((screen_width - prompt_fallback.GetWidth()) / 2);
        prompt_sprite.SetY(prompt_y);
        prompt_sprite.SetOpacity(1);
    }
    show_bullets(bullet_count);
}

Plymouth.SetDisplayPasswordFunction(display_password);

fun display_question(prompt, entry) {
    # Not a secret, so the answer is shown as typed rather than as bullets.
    target_opacity = 0.45;
    clear_bullets();
    show_prompt_text(prompt + "  " + entry);
}

Plymouth.SetDisplayQuestionFunction(display_question);

message_sprite = Sprite();
message_sprite.SetZ(9);
message_sprite.SetOpacity(0);

# A MESSAGE HAS TO EXPIRE ON ITS OWN, BECAUSE HIDING IT IS NOT RELIABLE.
#
# Plymouth's client can hide a message, and the daemon logs "hiding message
# ...", but on plymouth 24.004 the script plugin never calls the theme's
# hide-message callback -- verified by registering a callback that did nothing
# but reveal a marker sprite, and watching it stay hidden while
# SetDisplayMessageFunction fired normally on the same run. A theme that only
# clears on that callback leaves a stale "Checking disks" over the rest of the
# boot.
#
# So the message carries its own lifetime: each new message resets it, and it
# fades when nothing has refreshed it. Messages that matter during boot (fsck
# progress, service status) are reissued as they change, so they hold; one that
# is issued once and never withdrawn goes away by itself, which is the right
# failure.
fun display_message(text) {
    message_image = Image.Text(text, 0.72, 0.78, 0.86, 1.0, "Sans 11");
    if (!message_image || message_image.GetWidth() < 1) { return; }
    message_sprite.SetImage(message_image);
    message_sprite.SetX((screen_width - message_image.GetWidth()) / 2);
    message_sprite.SetY(screen_height - screen_height / 8);
    message_sprite.SetOpacity(1);
    message_ticks = message_lifetime;
}

Plymouth.SetMessageFunction(display_message);

fun hide_message(text) {
    # Registered anyway: it is correct where it works, and the expiry above is
    # what covers the builds where it does not.
    message_ticks = 0;
    message_sprite.SetOpacity(0);
}

Plymouth.SetHideMessageFunction(hide_message);

fun display_normal() {
    # The one that is easy to forget. Without it the passphrase prompt and its
    # bullets stay on screen after the disk unlocks, over the rest of the boot.
    target_opacity = 1.0;
    prompt_sprite.SetOpacity(0);
    clear_bullets();
}

Plymouth.SetDisplayNormalFunction(display_normal);

# --- quit -------------------------------------------------------------------

fun quit() {
    # Let the mark resolve rather than vanishing mid-sweep. Plymouth gives the
    # theme a moment before the handover, and the outro is sized to fit it.
    display_normal();
    phase = "outro";
    frame = 0;
}

Plymouth.SetQuitFunction(quit);
