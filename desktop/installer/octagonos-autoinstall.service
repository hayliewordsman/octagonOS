[Unit]
Description=octagonOS: unattended install, for the build's acceptance test
ConditionKernelCommandLine=octagonos.autoinstall
# The live session does not need to be up -- this writes a disk, it does not
# need a desktop -- but the filesystems it copies from must be mounted.
After=local-fs.target
Wants=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
# systemd's default start timeout is 90 seconds. Copying several gigabytes
# onto a virtual disk under software emulation takes very much longer than
# that, and when the timeout fires systemd kills the whole cgroup -- which
# would look exactly like the installer failing, for a reason nothing in its
# own output could explain.
TimeoutStartSec=infinity
ExecStart=/usr/lib/octagonos/octagonos-autoinstall.sh
StandardOutput=journal

[Install]
WantedBy=multi-user.target
