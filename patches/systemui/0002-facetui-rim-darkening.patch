+package com.android.systemui.facetui
+
+import android.graphics.RuntimeShader
+
+/**
+ * Darkens a glass surface toward its vertical edges.
+ *
+ * A pane of glass is optically thicker where it curves away, so it absorbs more
+ * light at the rim than through the middle. Reproducing that gives the panel a
+ * defined boundary without drawing a border on it.
+ *
+ * This replaces an earlier refraction shader that displaced sampling at the rim.
+ * That approach was measured and found to be invisible: the scrim's blur kernel
+ * is wider than the displacement gradient, so shifting samples changes nothing
+ * once the content behind is already diffused. The same is true of chromatic
+ * separation. The rule that follows is that on a blurred surface only effects
+ * which *modify values* survive; effects which *displace samples* do not.
+ *
+ * Intended to be chained after the blur, so it darkens diffused content.
+ */
+class FacetRimShader : RuntimeShader(SHADER) {
+
+    /** Width of the darkening band at each vertical edge, in pixels. */
+    var rim: Float = 48f
+        set(value) {
+            field = value
+            setFloatUniform("in_rim", value)
+        }
+
+    /** Peak darkening at the rim, 0..1. At 1.0 the edge goes black. */
+    var amount: Float = 0.35f
+        set(value) {
+            field = value
+            setFloatUniform("in_amount", value)
+        }
+
+    /** Surface size in pixels; the profile is computed against the width. */
+    fun setSize(width: Float, height: Float) {
+        setFloatUniform("in_size", width, height)
+    }
+
+    init {
+        // Self-assignment runs the setters, pushing the defaults into the
+        // shader's uniforms. See FacetEdgeShader for the same pattern.
+        rim = rim
+        amount = amount
+    }
+
+    companion object {
+        /** Name of the input shader uniform, for createRuntimeShaderEffect. */
+        const val INPUT_SHADER_NAME = "in_src"
+
+        private const val UNIFORMS = """
+            uniform shader in_src;
+            uniform vec2 in_size;
+            uniform float in_rim;
+            uniform float in_amount;
+        """
+
+        private const val MAIN = """
+            vec4 main(vec2 p) {
+                float r = max(in_rim, 1.0);
+
+                float dl = p.x / r;
+                float dr = (in_size.x - p.x) / r;
+
+                // Peaks at both vertical edges and falls to nothing across the
+                // middle, so the panel darkens at its rims only.
+                float band = abs(exp(-dl * dl) - exp(-dr * dr));
+
+                vec4 c = in_src.eval(p);
+
+                // Colour is premultiplied, so scaling rgb darkens without
+                // altering coverage. Alpha is deliberately left untouched.
+                return vec4(c.rgb * (1.0 - in_amount * band), c.a);
+            }
+        """
+
+        private const val SHADER = UNIFORMS + MAIN
+    }
+}
