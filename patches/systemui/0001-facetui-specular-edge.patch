+package com.android.systemui.facetui
+
+import android.graphics.RuntimeShader
+
+/**
+ * Draws a specular highlight along the top edge of a glass surface.
+ *
+ * Blur alone makes a panel look like frosted plastic. What reads as *glass* is
+ * the edge: a bright, narrow band where the surface curves away and catches the
+ * light. This shader produces that band, with a falloff down the panel and a
+ * gentle bias toward the centre so the edge reads as curved rather than flat.
+ *
+ * Follows the pattern SystemUI already uses for `DwellRippleShader`.
+ */
+class FacetEdgeShader : RuntimeShader(SHADER) {
+
+    /** Falloff distance in pixels. Larger is softer and more diffuse. */
+    var thickness: Float = 12f
+        set(value) {
+            field = value
+            setFloatUniform("in_thickness", value)
+        }
+
+    /** Peak alpha of the highlight, 0..1. */
+    var intensity: Float = 0.5f
+        set(value) {
+            field = value
+            setFloatUniform("in_intensity", value)
+        }
+
+    /** Panel size in pixels; the centre bias is computed against the width. */
+    fun setSize(width: Float, height: Float) {
+        setFloatUniform("in_size", width, height)
+    }
+
+    /** Highlight colour, linear 0..1 components. */
+    fun setTint(red: Float, green: Float, blue: Float) {
+        setFloatUniform("in_tint", red, green, blue)
+    }
+
+    init {
+        // Self-assignment is deliberate: it runs the setters above, which is
+        // what pushes the defaults into the shader's uniforms. Without this the
+        // uniforms are undefined until something happens to set them.
+        thickness = thickness
+        intensity = intensity
+        setTint(1f, 1f, 1f)
+    }
+
+    companion object {
+        private const val UNIFORMS = """
+            uniform vec2 in_size;
+            uniform float in_thickness;
+            uniform float in_intensity;
+            uniform vec3 in_tint;
+        """
+
+        private const val MAIN = """
+            vec4 main(vec2 p) {
+                float t = max(in_thickness, 1.0);
+
+                // Falloff from the top edge. Squared so the band stays tight at
+                // its peak and fades quickly, rather than smearing down the panel.
+                float d = p.y / t;
+                float edge = exp(-d * d * 2.0);
+
+                // Bias toward the centre, so the highlight reads as a curved
+                // surface catching light rather than a painted-on stripe.
+                float x = (p.x / max(in_size.x, 1.0)) * 2.0 - 1.0;
+                float arc = max(1.0 - x * x * 0.55, 0.0);
+
+                float a = clamp(edge * arc * in_intensity, 0.0, 1.0);
+
+                // AGSL expects premultiplied alpha.
+                return vec4(in_tint * a, a);
+            }
+        """
+
+        private const val SHADER = UNIFORMS + MAIN
+    }
+}
