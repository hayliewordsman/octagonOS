+    /**
+     * Draws the FacetUI specular edge across the top of the scrim, so the panel
+     * reads as a lit glass surface rather than a flat translucent fill. The
+     * highlight tracks the scrim's own alpha, so it fades in and out with the
+     * panel instead of appearing as a detached line.
+     */
+    private void drawFacetEdge(Canvas canvas) {
+        final int width = getWidth();
+        final int height = getHeight();
+        if (width <= 0 || height <= 0) {
+            return;
+        }
+        if (mFacetEdgeShader == null) {
+            mFacetEdgeShader = new FacetEdgeShader();
+            mFacetEdgePaint = new Paint();
+        }
+        final float thickness =
+                FACETUI_EDGE_THICKNESS_DP * getResources().getDisplayMetrics().density;
+        mFacetEdgeShader.setSize(width, height);
+        mFacetEdgeShader.setThickness(thickness);
+        mFacetEdgeShader.setIntensity(
+                (mDrawable.getAlpha() / 255f) * FACETUI_EDGE_MAX_INTENSITY);
+        mFacetEdgePaint.setShader(mFacetEdgeShader);
+        // The shader fades to nothing well before this bound; drawing the full
+        // height would cost fill rate for pixels that are already transparent.
+        canvas.drawRect(0f, 0f, width, thickness * 3f, mFacetEdgePaint);
+    }
