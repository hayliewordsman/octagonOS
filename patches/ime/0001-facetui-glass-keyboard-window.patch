+package com.android.inputmethod.latin.facetui;
+
+import android.content.Context;
+import android.view.Window;
+import android.view.WindowManager;
+
+import com.android.inputmethod.latin.R;
+
+/**
+ * Makes the keyboard window a FacetUI glass surface.
+ *
+ * A translucent keyboard is not a glass keyboard. Colours alone -- which is all
+ * an RRO overlay can change -- let the app behind show through unmodified, which
+ * reads as a tinted window, not as a pane above the content. What separates the
+ * two is blurring what is behind, and that is a window property, so it cannot be
+ * delivered by a resource. Hence this.
+ *
+ * Two things must both be true or the effect does not appear:
+ *
+ *   1. the window background must be translucent -- see the FacetUIIME overlay,
+ *      which is what supplies that half;
+ *   2. cross-window blur must be enabled, which depends on
+ *      {@code ro.surface_flinger.supports_background_blur} and on the user not
+ *      having turned blurs off.
+ *
+ * The second can change at runtime -- battery saver and the developer option
+ * "disable blurs" both switch it off -- so this listens rather than reading it
+ * once. Without the listener the keyboard keeps a stale translucent background
+ * with nothing blurred behind it, which looks worse than no glass at all.
+ */
+public final class FacetUiWindowGlass {
+
+    private final Context mContext;
+    private Window mWindow;
+    private boolean mListenerAttached;
+
+    private final java.util.function.Consumer<Boolean> mBlurEnabledListener =
+            this::onBlurEnabledChanged;
+
+    public FacetUiWindowGlass(final Context context) {
+        mContext = context;
+    }
+
+    /**
+     * Attaches to the keyboard window and applies the blur. Safe to call every
+     * time the window is shown; attaching is idempotent.
+     */
+    public void attach(final Window window) {
+        if (window == null) {
+            return;
+        }
+        mWindow = window;
+        final WindowManager wm = mContext.getSystemService(WindowManager.class);
+        if (wm != null && !mListenerAttached) {
+            wm.addCrossWindowBlurEnabledListener(mContext.getMainExecutor(),
+                    mBlurEnabledListener);
+            mListenerAttached = true;
+        }
+        apply(wm == null || wm.isCrossWindowBlurEnabled());
+    }
+
+    /** Detaches the listener. Call from the service's onDestroy. */
+    public void detach() {
+        final WindowManager wm = mContext.getSystemService(WindowManager.class);
+        if (wm != null && mListenerAttached) {
+            wm.removeCrossWindowBlurEnabledListener(mBlurEnabledListener);
+            mListenerAttached = false;
+        }
+        mWindow = null;
+    }
+
+    private void onBlurEnabledChanged(final boolean enabled) {
+        apply(enabled);
+    }
+
+    private void apply(final boolean blurEnabled) {
+        if (mWindow == null) {
+            return;
+        }
+        final int radius = blurEnabled
+                ? mContext.getResources().getDimensionPixelSize(
+                        R.dimen.facetui_keyboard_blur_radius)
+                : 0;
+        mWindow.setBackgroundBlurRadius(radius);
+    }
+}
