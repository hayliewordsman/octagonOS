index 0000000..033f5c9
--- /dev/null
+++ b/java/res/values/facetui.xml
@@ -0,0 +1,14 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     FacetUI keyboard glass.
+
+     This is a dimen rather than a constant so the FacetUIIME overlay can retune
+     it per device without another build -- the same reason the rest of the
+     depth model lives in resources.
+-->
+<resources>
+    <!-- L3 in the FacetUI depth model. The keyboard is a large surface sitting
+         directly over app content, so it takes the same depth as the shade
+         rather than the shallower tier used for small popups. -->
+    <dimen name="facetui_keyboard_blur_radius">48dp</dimen>
+</resources>
