+    /**
+     * FacetUI: applies the configured status bar icon mode.
+     *
+     * Returns the notifications to show, and the icon to show for each. The
+     * icon is returned separately rather than mutated onto the model because
+     * [toIconInfo] already takes it as a parameter, which is what makes mode 2
+     * a substitution rather than a rewrite.
+     *
+     * Mode 2 sorts before taking one. The source is a [Set], so `take(1)` on it
+     * would pick an arbitrary element and the dot could flicker between
+     * notifications on every emission. Sorting by key is not chronological --
+     * [ActiveNotificationIconModel] carries no timestamp on this release -- but
+     * it is stable, which is the property that actually matters here: the dot
+     * is a plain circle either way, so *which* notification backs it is not
+     * observable, only whether it keeps changing.
+     */
+    private fun facetUiFilter(
+        entries: Set<ActiveNotificationIconModel>
+    ): Pair<Collection<ActiveNotificationIconModel>, (ActiveNotificationIconModel) -> Icon?> {
+        return when (facetUiIconMode) {
+            FACETUI_MODE_ALERTING_ONLY ->
+                entries.filterNot { it.isAmbient } to { it: ActiveNotificationIconModel ->
+                    it.statusBarIcon
+                }
+            FACETUI_MODE_NEUTRAL_DOT ->
+                entries.sortedBy { it.notifKey }.take(1) to { _: ActiveNotificationIconModel ->
+                    facetUiDot
+                }
+            FACETUI_MODE_HIDDEN ->
+                emptyList<ActiveNotificationIconModel>() to { _: ActiveNotificationIconModel ->
+                    null
+                }
+            else ->
+                entries to { it: ActiveNotificationIconModel -> it.statusBarIcon }
+        }
+    }
+
+    private companion object {
+        const val FACETUI_MODE_ALERTING_ONLY = 1
+        const val FACETUI_MODE_NEUTRAL_DOT = 2
+        const val FACETUI_MODE_HIDDEN = 3
+    }
