+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     FacetUI: the neutral notification indicator.
+
+     A plain circle, deliberately carrying no app identity. Solid white so the
+     status bar's existing dark/light tinting applies to it exactly as it does
+     to a real notification icon.
+-->
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="24dp"
+    android:height="24dp"
+    android:viewportWidth="24"
+    android:viewportHeight="24">
+    <path
+        android:fillColor="#FFFFFFFF"
+        android:pathData="M12,12m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0" />
+</vector>
