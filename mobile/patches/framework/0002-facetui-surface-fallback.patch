+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.internal.policy;
+
+import android.content.Context;
+import android.graphics.Color;
+import android.graphics.drawable.ColorDrawable;
+import android.graphics.drawable.Drawable;
+import android.provider.Settings;
+import android.util.TypedValue;
+
+import com.android.internal.R;
+
+/**
+ * What a FacetUI surface does when it cannot be glass.
+ *
+ * Every FacetUI surface is translucent so that the blur behind it shows
+ * through. When the blur is not there, the translucency is left doing nothing
+ * useful and a good deal of harm: a panel at 77% over unblurred, scrolling
+ * content is harder to read than an opaque one, and the design has quietly
+ * become worse than no design.
+ *
+ * Blur goes away for ordinary reasons, on devices nobody here has tested:
+ *
+ *   battery saver turns cross-window blur off
+ *   the developer option "disable blurs" turns it off
+ *   a GPU that cannot afford it never had it
+ *
+ * So this is not an edge case to note in a document; it is a state real users
+ * will sit in for hours. The answer is to stop being translucent: an opaque
+ * backing layer goes underneath the surface's own background, which then
+ * composites over it. The tint stays, the legibility comes back, and nothing
+ * above this has to know.
+ *
+ * ACCESSIBILITY
+ *
+ * The same path serves high contrast text. Android has no "reduce
+ * transparency" setting, but a user who has asked for high contrast has said
+ * as clearly as the platform allows that they want legibility over effect, and
+ * translucent panels are the opposite of that. When it is on, surfaces
+ * solidify whether or not blur is available.
+ *
+ * That also means the existing, user-facing "disable blurs" toggle doubles as a
+ * reduce-transparency control, which is worth more than a setting only
+ * octagonOS knows about.
+ *
+ * Off unless asked for: R.bool.facetui_solidify_when_no_blur is false in the
+ * platform.
+ */
+public final class FacetUiSurfaceFallback {
+
+    private FacetUiSurfaceFallback() {}
+
+    /**
+     * Whether a surface that wanted glass should go opaque instead.
+     *
+     * @param requestedBlur the radius the surface's theme asked for. Zero means
+     *        the surface never wanted glass, and must be left alone -- a
+     *        genuinely transparent window (a wallpaper host, a translucent
+     *        activity) would be ruined by an opaque backing.
+     */
+    public static boolean shouldSolidify(Context context, int requestedBlur,
+            boolean crossWindowBlurEnabled) {
+        if (context == null || requestedBlur <= 0) {
+            return false;
+        }
+        if (!context.getResources().getBoolean(R.bool.facetui_solidify_when_no_blur)) {
+            return false;
+        }
+        return !crossWindowBlurEnabled || isHighContrastText(context);
+    }
+
+    /**
+     * An opaque layer to put underneath a translucent FacetUI background.
+     *
+     * The colour is the surface's own, with alpha forced to opaque, so a
+     * solidified panel keeps the hue it would have had. Taking a fixed colour
+     * here would undo the wallpaper-derived tint the overlays go to some
+     * trouble to preserve.
+     */
+    public static Drawable backing(Context context) {
+        final TypedValue tv = new TypedValue();
+        int colour = Color.BLACK;
+        if (context != null
+                && context.getTheme().resolveAttribute(
+                        android.R.attr.colorBackground, tv, true)) {
+            colour = tv.type >= TypedValue.TYPE_FIRST_COLOR_INT
+                    && tv.type <= TypedValue.TYPE_LAST_COLOR_INT
+                    ? tv.data
+                    : context.getColor(tv.resourceId);
+        }
+        return new ColorDrawable(colour | 0xFF000000);
+    }
+
+    /**
+     * Read from Settings rather than AccessibilityManager on purpose:
+     * isHighContrastTextEnabled() is behind a feature flag, and a surface that
+     * silently stops solidifying because a flag moved is exactly the kind of
+     * failure this class exists to prevent. The Settings key is stable.
+     */
+    private static boolean isHighContrastText(Context context) {
+        try {
+            return Settings.Secure.getInt(context.getContentResolver(),
+                    Settings.Secure.ACCESSIBILITY_HIGH_TEXT_CONTRAST_ENABLED, 0) != 0;
+        } catch (RuntimeException e) {
+            return false;
+        }
+    }
+}
