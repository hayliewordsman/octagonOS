diff --git a/core/java/com/android/internal/policy/FacetUiSurfaceFallback.java b/core/java/com/android/internal/policy/FacetUiSurfaceFallback.java
new file mode 100644
index 000000000..7a7fbdd50
--- /dev/null
+++ b/core/java/com/android/internal/policy/FacetUiSurfaceFallback.java
@@ -0,0 +1,123 @@
