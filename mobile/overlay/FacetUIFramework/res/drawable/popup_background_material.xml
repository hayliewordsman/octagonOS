<?xml version="1.0" encoding="utf-8"?>
<!--
     FacetUI: popup and menu panels - overflow menus, spinner dropdowns,
     autocomplete lists. One drawable serves all of them; every popup widget
     style in the platform points popupBackground at this file.

     TRANSLUCENT, NOT BLURRED, AND THAT IS A REAL LIMIT

     A PopupWindow is not a PhoneWindow. It attaches a view straight to the
     WindowManager, so it never runs PhoneWindow.generateLayout() and the blur
     attributes that make dialogs glass do nothing here. PopupWindow itself
     exposes no blur API at all - checked, there is none in the class.

     So this is tint and hairline only. By FacetUI's own rule that is a tinted
     window rather than glass, and it is the honest ceiling for a resource-only
     change. Real popup glass needs a small framework patch to set a blur radius
     on the popup's window; see docs/facetui.md.

     The colour is a literal rather than ?attr/colorPopupBackground, which
     resolves to the host activity's opaque window background outside a dialog.
     That costs day/night following the THEME and makes it follow the
     CONFIGURATION instead, via drawable-night - so an app that forces a light
     theme while the system is in night mode gets the dark panel. Rare, and
     preferable to every menu in the system staying opaque.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="2dp" />
    <!-- 0xCC = 80%, so about a fifth of what is behind comes through. A
         compromise, deliberately: with patches/framework/0001 applied there is
         a blur behind this and it could open further, but the same drawable
         ships on a Tier 2 image where there is not, and at much lower alpha an
         unblurred menu becomes hard to read over busy content. -->
    <solid android:color="#CCF7F9FD" />
    <stroke
        android:width="1dp"
        android:color="#2E000000" />
</shape>
