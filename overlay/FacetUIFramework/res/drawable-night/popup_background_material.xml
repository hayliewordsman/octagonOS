<?xml version="1.0" encoding="utf-8"?>
<!--
     FacetUI: popup and menu panels, dark. See the notes on the default
     variant in drawable/ - in particular why this is a literal colour and what
     that costs.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="2dp" />
    <!-- 0xC2 = 76%. A dark panel over dark content needs to be more open
         than a light one to read as a separate surface at all. Same Tier 2
         compromise as the default variant. -->
    <solid android:color="#C21A1D24" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
